-- the whole tree
def tree8 : Tree 8 :=
  tree8510

/-- A `16`-comparison decision tree sorting eight positions.  A node
`.node i j l r` compares positions `i` and `j`: `l` is taken when `x i < x j`,
`r` otherwise.  The comment on each internal node is the number of orderings of
the eight positions consistent with the answers that lead to it. -/
def tree8 : Tree 8 :=
  tree8510

/-- The depth is `16`: sixteen comparisons always suffice.  (`depth` is the maximum
over leaves, so some leaf sits exactly at depth `16`.) -/
theorem tree8_depth : depth tree8 = 16 := by decide

/-- As many leaves as there are orderings of eight elements. -/
theorem tree8_numLeaves : numLeaves tree8 = 40320 := by decide

-- `decide` folds over the `8! = 40320` canonical inputs listed by `allPerms 8`
-- (`Verify.lean`), never over the `8 ^ 8 = 16777216` functions `Fin 8 → Fin 8` of
-- the `Fintype (Equiv.Perm (Fin 8))` instance.  The fold is `40320` elements deep,
-- past the elaborator's default recursion limit of 1000, and far past the default
-- heartbeat budget, so both limits are lifted.
set_option maxHeartbeats 0 in
set_option maxRecDepth 500000 in
/-- The tree sorts: on all `8! = 40320` canonical inputs it outputs the sorting
permutation, hence on every input with distinct values. -/
theorem tree8_correct : Correct (α := ℕ) tree8 :=
  correct_of_allPerms (by decide)

/-- **`S 8 = 16`**: sixteen comparisons sort eight elements, and counting rules out
fifteen. -/
theorem S_eight : S 8 = 16 := by
  refine le_antisymm ?_ ?_
  · -- upper bound: the adaptive tree
    refine (S_le_iff 8 16).2 ⟨tree8, tree8_correct, ?_⟩
    rw [tree8_depth]
  · -- lower bound: `Nat.clog 2 8! = 16`
    have h := S_lower 8
    have h40320 : Nat.clog 2 (Nat.factorial 8) = 16 := by decide
    omega

/-- **Sixteen comparisons are necessary in the *comparison-count* reading too**: no
correct tree keeps every input at `≤ 15` comparisons. -/
theorem eight_needs_sixteen_comparisons :
    ¬ ∃ t : Tree 8, Correct (α := ℕ) t ∧
      ∀ x : Fin 8 → ℕ, Function.Injective x → cost t x ≤ 15 := by
  rintro ⟨t, ht, hcost⟩
  have hwc : worstCase t ≤ 15 := by
    apply Finset.sup_le
    intro p _
    exact hcost (xOfPerm p) (xOfPerm_injective p)
  have hlb := logb_factorial_le_worstCase ht
  have h40320 : (15 : ℝ) < Real.logb 2 (Nat.factorial 8) := by
    have hfac : ((Nat.factorial 8 : ℕ) : ℝ) = 40320 := by norm_num [Nat.factorial]
    rw [hfac]
    have hpow : (2 : ℝ) ^ 15 < 40320 := by norm_num
    calc (15 : ℝ) = Real.logb 2 ((2 : ℝ) ^ 15) := by
          rw [Real.logb_pow, Real.logb_self_eq_one (by norm_num)]; norm_num
      _ < Real.logb 2 (40320 : ℝ) :=
          Real.logb_lt_logb (b := 2) (by norm_num : (1 : ℝ) < 2) (by positivity) hpow
  have : (worstCase t : ℝ) ≤ 15 := by exact_mod_cast hwc
  linarith

end SortBounds.Projects.SN
